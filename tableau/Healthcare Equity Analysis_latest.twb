    <dashboard name='Story 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1b1b1b' fontname='Tableau Book,Tableau,Arial,sans-serif' fontsize='11' underline='true'>THE PROBLEM</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book,Tableau,Arial,sans-serif' fontsize='11' italic='true'>4.1 million Americans live in counties with high socioeconomic vulnerability.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Book,Tableau,Arial,sans-serif' fontsize='11' italic='true'>Many of these areas also lack adequate hospital access, creating a dual burden.</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='299' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97970' id='7' param='vert' removable='false' type-v2='layout-flow' w='98892' x='554' y='1015'>
            <zone h='97970' id='1' param='vert' removable='false' type-v2='layout-flow' w='98892' x='554' y='1015'>
              <zone fixed-size='86' h='10914' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98892' x='554' y='1015' />
              <zone h='87056' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98892' x='554' y='11929'>
                <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='Identifying priority counties for healthcare infrastructure investment' captured-sheet='Dashboard 1' id='1'>
                      <capturedDeltas>
                        <worksheet name='Sheet 1'>
                          <style delta-type='added'>
                            <style-rule element='axis'>
                              <encoding attr='space' class='0' field='[federated.1517m8f12rb6w81at8xzz1ns04v7].[Latitude (generated)]' field-type='quantitative' projection='EPSG:3857' scope='rows' type='space' />
                              <encoding attr='space' class='0' field='[federated.1517m8f12rb6w81at8xzz1ns04v7].[Longitude (generated)]' field-type='quantitative' projection='EPSG:3857' scope='cols' type='space' />
                            </style-rule>
                          </style>
                        </worksheet>
                        <worksheet name='Sheet 6'>
                          <selection-collection />
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                    <story-point caption='Interactive exploration of vulnerability and access metrics by county and state' captured-sheet='Dashboard 2' id='2' />
                  </story-points>
                </flipboard>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='20812' id='8' story-point-id='1' type-v2='text' w='35249' x='28324' y='62944'>
          <formatted-text>
            <run bold='true' fontcolor='#1b1b1b' underline='true'>THE PROBLEM:</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#1b1b1b' italic='true'>4.1 million Americans live in counties with high socioeconomic vulnerability.</run>
            <run fontalignment='0'>Æ&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#1b1b1b' italic='true'>Many of these areas also lack adequate hospital access, creating a dual burden.</run>
          </formatted-text>
        </zone>
